{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/pre-tool-use.sh"
          }
        ]
      }
    ]
  },
  "agents": {
    "codeReviewer": {
      "enabled": true,
      "file": ".claude/agents/code-reviewer.md",
      "autoTrigger": "on PR review request"
    },
    "debugger": {
      "enabled": true,
      "file": ".claude/agents/debugger.md",
      "autoTrigger": "on error diagnosis"
    },
    "testWriter": {
      "enabled": true,
      "file": ".claude/agents/test-writer.md",
      "autoTrigger": "on new feature or bug fix"
    },
    "refactorer": {
      "enabled": true,
      "file": ".claude/agents/refactorer.md",
      "autoTrigger": "on explicit refactor request"
    },
    "docWriter": {
      "enabled": true,
      "file": ".claude/agents/doc-writer.md",
      "autoTrigger": "on docs update or post-commit"
    },
    "securityAuditor": {
      "enabled": true,
      "file": ".claude/agents/security-auditor.md",
      "autoTrigger": "on pre-deploy or security concern"
    }
  },
  "commands": {
    "fixIssue": {
      "enabled": true,
      "file": ".claude/commands/fix-issue.md",
      "invoke": "/fix-issue <issue-number>"
    },
    "deploy": {
      "enabled": true,
      "file": ".claude/commands/deploy.md",
      "invoke": "/deploy"
    },
    "preReview": {
      "enabled": true,
      "file": ".claude/commands/pre-review.md",
      "invoke": "/pre-review"
    }
  },
  "rules": {
    "frontend": {
      "enabled": true,
      "file": ".claude/rules/frontend.md",
      "appliesTo": ["app/**/*.ts", "app/**/*.tsx"]
    },
    "database": {
      "enabled": true,
      "file": ".claude/rules/database.md",
      "appliesTo": ["lib/supabase.ts", "**/*.ts"]
    },
    "api": {
      "enabled": true,
      "file": ".claude/rules/api.md",
      "appliesTo": ["app/api/**/*.ts"]
    },
    "gitPush": {
      "enabled": true,
      "file": ".claude/rules/git-push.md",
      "appliesTo": ["*"]
    }
  },
  "permissions": {
    "allow": [
      "Bash(npm run test)",
      "Bash(npm run lint)",
      "Bash(npm run build)",
      "Bash(npm run dev)",
      "Bash(gh issue view*)",
      "Bash(gh pr create*)",
      "Bash(git status)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(git checkout*)",
      "Bash(git branch*)",
      "Bash(npx supabase status)"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git reset --hard*)",
      "Bash(rm -rf*)",
      "Bash(npx supabase db reset)",
      "Bash(DROP TABLE*)",
      "Bash(DELETE FROM enrich_*)"
    ]
  }
}
